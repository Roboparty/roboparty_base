#!/usr/bin/make -f

INSTALL_PREFIX ?= /opt/roboparty
export DH_VERBOSE = 1

%:
	dh $@

override_dh_auto_configure:
override_dh_auto_build:
override_dh_auto_test:
override_dh_auto_clean:
override_dh_auto_install:

override_dh_install:
	dh_install

	install -d debian/roboparty-base$(INSTALL_PREFIX)/include
	install -d debian/roboparty-base$(INSTALL_PREFIX)/bin
	install -d debian/roboparty-base$(INSTALL_PREFIX)/share

	install -m 644 setup.bash debian/roboparty-base$(INSTALL_PREFIX)/

	install -d debian/roboparty-base/usr/lib/python3/dist-packages
	install -m 644 roboparty.pth debian/roboparty-base/usr/lib/python3/dist-packages/

	install -d debian/roboparty-base/etc/udev/rules.d
	install -m 644 etc/udev/rules.d/*.rules debian/roboparty-base/etc/udev/rules.d/

override_dh_installdeb:
	dh_installdeb
	sed -i 's|@INSTALL_PREFIX@|$(INSTALL_PREFIX)|g' \
		debian/roboparty-base/DEBIAN/postinst \
		debian/roboparty-base/DEBIAN/postrm
